{
  "manifest_version": 3,
  "name": "Anti-CookieSheep",
  "version": "1.4",
  "description": "Decidi tu chi bloccare: Meta, TikTok, Google, cookie banner in tutte le lingue e Scudo IP/HTTPS.",
  "icons": {
    "48": "preview.png",
    "128": "preview.png"
  },
  "action": {
    "default_icon": "preview.png",
    "default_title": "Anti-CookieSheep - Pannello",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "anti-cookiesheep@kaelen-simple.local",
      "strict_min_version": "113.0"
    }
  },
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "privacy"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}

